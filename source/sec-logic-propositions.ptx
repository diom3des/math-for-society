		<exercise><!--  #5 new -->
			<statement>
			<p>
				Write the negation of each proposition.
			</p>
			<p>
				<ol marker="a)">
					<li>
						<p>
							Nobody rides their bike to campus.
						</p>
					</li>
					<li>
						<p>
							All cities named College Place are in Washington.
						</p>
					</li>
				</ol>
			</p>
			</statement>
			<solution>
				<p>
				<ol marker="a)">
					<li>
						<p>
							Some people ride their bike to campus, or There are people who ride their bike to campus.
						</p>
					</li>
					<li>
						<p>
							There are cities named College Place that are not in Washington.
						</p>
					</li>
				</ol>
				</p>
			</solution>
		</exercise>
		
		<exercise><!--  #6 new -->
			<statement>
			<p>
				Write the negation of each proposition.
			</p>
			<p>
				<ol marker="a)">
					<li>
						<p>
