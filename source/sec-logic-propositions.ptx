		<exercise><!--  #13 -->
			<statement>
			<p>
				Rewrite each statement in the conditional form <em>if</em> <m>p</m>, <em>then</em> <m>q</m>.
			</p>
			<p>
				<ol marker="a)">
					<li>
						<p>
							Whenever it is sunny, I go swimming.
						</p>
					</li>
					<li>
						<p>
							I go see a movie on Fridays.
						</p>
					</li>
				</ol>
			</p>
			</statement>
			<solution>
			<p>
				<ol marker="a)">
					<li>
						<p>
							If it is sunny, then I will go swimming.
						</p>
					</li>
					<li>
						<p>
							If it is Friday, then I will go see a movie.
						</p>
					</li>
				</ol>
			</p>
			</solution>
		</exercise>
		
		<exercise> <!-- #14 -->
			<statement>
			<p>
				Rewrite each statement in the conditional form <em>if</em> <m>p</m>, <em>then</em> <m>q</m>.
			</p>
			<p>
				<ol marker="a)">
					<li>
						<p>
							I always carry an umbrella when it rains.
						</p>
					</li>
					<li>
						<p>
							On the weekend I like to hang out with friends.
						</p>
					</li>
				</ol>
			</p>
			</statement>
			<solution>
			<p>
				<ol marker="a)">
					<li>
						<p>
							If it is raining, then I carry an umbrella.
						</p>
					</li>
					<li>
						<p>
							If it is the weekend, then I like to hang out with friends.
						</p>
					</li>
				</ol>
			</p>
			</solution>
		</exercise>
		
		<exercise><!--  #15 -->
			<statement>
			<p>
				Determine whether each statement is true or false.
			</p>
			<p>
				<ol marker="a)">
					<li>
						<p>
							An apple is a vegetable or an apple is a fruit.
						</p>
					</li>
					<li>
						<p>
							Walla Walla is not a city in Washington.
						</p>
					</li>
					<li>
						<p>
							Fish have feathers and birds can swim.
						</p>
					</li>
					<li>
						<p>
							If <m>2 + 5 = 10</m>, then <m>2 + 7 = 12</m>.
						</p>
					</li>
				</ol>
			</p>
			</statement>
			<solution>
				<p>
				<ol marker="a)">
					<li>
						<p>
							True
						</p>
					</li>
					<li>
						<p>
							False
						</p>
					</li>
					<li>
						<p>
							False
						</p>
					</li>
					<li>
						<p>
							True
						</p>
					</li>
				</ol>
				</p>
			</solution>
		</exercise>
		
		<exercise><!--  #16 -->
