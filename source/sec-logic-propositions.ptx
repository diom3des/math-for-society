						</p>
					</li>
					<li>
						<p>
							College Place is not in Washington.
						</p>
					</li>
				</ol>
			</p>
			</statement>
			<solution>
				<p>
				<ol marker="a)">
					<li>
						<p>
							I do not ride my bike to campus.
						</p>
					</li>
					<li>
						<p>
							College Place is in Washington.
						</p>
					</li>
				</ol>
				</p>
			</solution>
		</exercise>
		
		<exercise><!--  #4 -->
