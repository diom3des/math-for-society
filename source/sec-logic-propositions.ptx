					<li>
						<p>
							False
						</p>
					</li>
					<li>
						<p>
							True
						</p>
					</li>
					<li>
						<p>
							False
						</p>
					</li>
				</ol>
				</p>
			</solution>
		</exercise>
		
		<exercise><!--  #17 -->
