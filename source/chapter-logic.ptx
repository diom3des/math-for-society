	<xi:include href="sec-logic-truth-tables.ptx" />
	<xi:include href="sec-logic-equivalence.ptx" />
	<xi:include href="sec-logic-arguments.ptx" />
	<xi:include href="sec-logic-fallacies.ptx" />

</chapter>