<?xml version="1.0" encoding="UTF-8"?>

<!-- Book-wide settings (the analogue of a LaTeX preamble). -->
<docinfo xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Unique id for the book: lowercase, no spaces or dashes. -->
  <document-id>mathforsociety</document-id>
  <blurb>An open textbook for Walla Walla University's MATH 105, Math for the Liberal Arts.</blurb>

  <!-- Prefix for the HTML page titles (browser tabs, bookmarks). -->
  <initialism>Math for Society:</initialism>

  <!-- Preamble for every latex-image (web SVGs and the PDF). -->
  <latex-image-preamble> 
    \usepackage{tikz, pgfplots} 
    \usepackage{venndiagram} 
    \usetikzlibrary{positioning,matrix,arrows} 
    \usetikzlibrary{shapes,decorations,shadows,fadings,patterns} 
    \usetikzlibrary{decorations.markings} 
    \usetikzlibrary{calc} 
    \pgfplotsset{compat=1.18} 
    \definecolor{CustomB1}{RGB}{17,117,167}
    \definecolor{CustomB2}{RGB}{60,84,111}
    \usepackage[parfill]{parskip} % no indent skip line between paragraphs
    %
    % FONTS. This preamble is used twice: to compile each latex-image alone
    % into a web SVG, and (pasted into the book's preamble) for the PDF,
    % where the TikZ code is recompiled inline. Every graphic sets its text
    % with \figfont, so the graphics font is chosen here, per output.
    % Math in graphics uses the document's math font (Computer Modern now).
    % \divisionfont is defined by PreTeXt's PDF preamble only.
    \ifdefined\divisionfont
      % PDF: print fonts go here; point \figfont at the family the
      % graphics should use (e.g. \rmfamily to match the body text).
      \usepackage{libertine}
      \usepackage[defaultsans]{opensans}
      \newcommand{\figfont}{\sffamily}
    \else
      % Web SVGs: Open Sans, to match the HTML body text, for ALL labels:
      % mathastext sets math letters, digits and ( ) = + / in the text
      % font, so $A$, $A^C$, $1/4$ match the plain-text labels. fontspec's
      % no-math keeps it from resetting math digits to Latin Modern.
      \PassOptionsToPackage{no-math}{fontspec}
      \usepackage[defaultsans]{opensans}
      \renewcommand{\familydefault}{\sfdefault}
      \usepackage[italic]{mathastext}
      \newcommand{\figfont}{\sffamily}
    \fi
    % pgfplots numbers (tick labels, nodes near coords) as text, not math,
    % so they take the axis's font=\figfont setting
    \pgfplotsset{/pgf/number format/assume math mode=true}
  </latex-image-preamble>

</docinfo>
