<?xml version="1.0" encoding="UTF-8"?>

<!-- Publication file: settings for how the book is rendered.            -->
<!-- Full list of options:                                               -->
<!-- https://pretextbook.org/doc/guide/html/publisher-file-reference.html -->

<publication>
  <common>
    <tableofcontents level="2"/>
    <!-- Inline exercises (in examples) show their solutions; the       -->
    <!-- end-of-section exercises keep theirs hidden. An instructor     -->
    <!-- edition would set exercise-divisional solution="yes".          -->
    <exercise-inline hint="no" answer="no" solution="yes"/>
    <exercise-divisional hint="no" answer="no" solution="no"/>
  </common>

  <source>
    <!-- Relative to source/main.ptx. Everything in external/ is copied -->
    <!-- to the website, so keep design source files out of it.        -->
    <directories external="../assets" generated="../generated-assets" />
  </source>

  <latex print="yes" sides="two" pageref="no" font-size="11">
    <page>
      <geometry>papersize={8.5in,11in},total={6.5in,9in}</geometry>
    </page>
  </latex>

  <html>
    <knowl exercise-inline="no" example="no"/>
    <index-page ref="math-for-society"/>
    <css theme="salem" palette="ice-fire"/>
    <toc focused="no" preexpanded-levels="2" />
    <baseurl href="https://mathforsociety.org/"/>
  </html>
</publication>
